# Environment Configuration Template
# Copy this to a .env.local file and fill in your values

# Google Apps Script Web App URL for form submissions
# Get this from the Apps Script deployment (https://script.google.com)
VITE_GOOGLE_SHEET_ENDPOINT=YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL

# WhatsApp Group Invite Link
# Create a WhatsApp group and get the invite link
VITE_WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/YOUR_GROUP_LINK
